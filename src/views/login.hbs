                                                <rect width="16" height="12" rx="2" fill="white" />
                                            </clipPath>
                                        </defs>
                                    </svg>
                                    <span>+995</span>
                                </div>
                            </div>
                        </div>
                        <button class="button" id="oneTimeCode">
                            კოდის გაგზავნა
                        </button>
                    </div>
                    <div class="auth-verify-number">
                        <div class="auth-input-wrapper">
                            <label for="user-input" class="input-label">ერთჯერადი კოდი</label>
                            <div class="input-wrapper">
                                <input type="number" id="user-otp-code" class="auth-input otp-input" autocomplete="off">
                            </div>
                        </div>
                    </div>
                    <div class="auth-input-wrapper">
                        <label for="user-password" class="input-label">პაროლი*</label>
                        <div class="input-wrapper">
                            <input type="password" id="user-password" class="auth-input" autocomplete="off">
                            <button class="button button-icon eye-on" id="eyeOn">
                               
                                <i class="material-symbols-outlined eye-icon">visibility</i>
                                <div class="tooltip">პაროლის ჩვენება</div>
                            </button>
                            <button class="button button-icon eye-off" id="eyeOff" style="display: none;">
                                <i class="material-symbols-outlined eye-icon">visibility_off</i>
                                <div class="tooltip">პაროლის დაფარვა</div>
                            </button>
                        </div>

                    </div>
                   
                    <div class="error-message">აუცილებელია ყველა ველის შევსება*</div>
                    <button class="button auth-button" id="submitButton">
                        შესვლა
                    </button>
                    <a href="/verify" class="button reg-button" id="regButton">
                        რეგისტრაცია
                    </a>

                </div>
            </div>
        </div>
    </div>

    <div class="overlay-container"></div>
    <div class="toast-container"></div>
    <script src="/public/js/login.js" type="module"></script>
