<div class="addGroup-container">
    <div class="contacts-header">
        <button class="button button-icon display-bn" id="accBackButton">
            <i class="material-symbols-outlined">chevron_left</i>
        </button>
        <span>ჯგუფის დამატება</span>
        <span class="material-symbols-outlined">beenhere</span>
    </div>
    <div class="group-add-content">

        <div class="group-name-container">
            <div class="auth-input-wrapper grop-add-input-wrapper">
                <label for="user-mail" class="input-label user-label">ჯგუფის სახელი</label>
                <div class="input-wrapper">
                    <input type="text" id="addGroupName" class="auth-input">
                    <div class="input-group-append">
                        <i class="material-symbols-outlined">group</i>
                    </div>
                </div>
            </div>
        </div>
        <div class="group-select-container">
            <label>ჯგუფის წევრები</label>
            <div class="custom-select" name="model" id="addGroupWrapper">
                <button class="select-button" role="combobox" aria-labelledby="select button" aria-haspopup="listbox"
                    aria-expanded="false" aria-controls="listbox" id="addGroup">
                    <span class="select-value">--დაამატე ჯგუფი--</span>
                    <i class="material-symbols-outlined">arrow_drop_down</i>
                </button>
                <ul role="listbox" id="addGroupList" class="select-dropdown" aria-multiselectable="true">
                    {{#each users as |user i|}}
                    <li role="option" class="language-listitem list-item" value="{{this.id}}">
                        <span class="checkbox__mark"></span>
                        <i class="material-symbols-outlined">person</i>
                        <span class="list-item-content" style="align-self: unset;">{{this.name}}</span>

                    </li>
                    {{/each}}
                </ul>
            </div>
        </div>
        <div class="group-select-container">
            <label>ადმინი</label>
            <div class="custom-select" id="addAdminWrapper">
                <button class="select-button" role="combobox" aria-labelledby="select button" aria-haspopup="listbox"
                    aria-expanded="false" aria-controls="listbox" id="addAdmin">
                    <span class="select-value">--დაამატე ადმინი--</span>
                    <i class="material-symbols-outlined">arrow_drop_down</i>
                </button>
                <ul role="listbox" id="addAdminList" class="select-dropdown"></ul>
            </div>
        </div>
        <button class="button" id="addGroupButton">დამატება</button>
        <div class="addGroup-hydration" style="display: none;">{{hydration}}</div>
    </div>
</div>